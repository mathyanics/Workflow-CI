name: credit-default-risk

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data:
        type: str
        default: credit_default_preprocessed.csv
    command: "python3 modelling.py --data {data}"

  tuning:
    parameters:
      data:
        type: str
        default: credit_default_preprocessed.csv
    command: "python3 modelling_tuning.py --data {data}"
